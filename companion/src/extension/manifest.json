{
  "manifest_version": 3,
  "name": "GC Wallet Companion",
  "version": "0.0.0",
  "description": "Walmart balance review with user-triggered form fill and result capture.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GC Wallet Companion"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/fixture.html*"
      ],
      "js": [
        "fixture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.walmart.ca/en/account/giftcards/balance"
      ],
      "js": [
        "merchant-assist.js",
        "overlay-position.js",
        "checker-launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://walmart-gc.dotsthewarlock.com/*",
    "https://www.walmart.ca/*",
    "https://walmart.ca/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "https://www.walmart.ca/*"
      ]
    }
  ]
}
